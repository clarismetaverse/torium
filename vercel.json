{
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/listing-asset.js": { "maxDuration": 30, "regions": ["fra1"] },
    "api/renewals.js": { "maxDuration": 30, "regions": ["fra1"] },
    "api/run-triage.js": { "maxDuration": 300 },
    "api/run-valuation.js": { "maxDuration": 300 },
    "api/run-villas.js": { "maxDuration": 300 }
  },
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/auth-session", "destination": "/api/account?resource=session" },
    { "source": "/api/investor-preferences", "destination": "/api/account?resource=preferences" },
    { "source": "/api/triage-runs", "destination": "/api/triage?resource=runs" },
    { "source": "/api/triage-properties", "destination": "/api/triage?resource=properties" },
    { "source": "/api/triage-source-listings", "destination": "/api/triage?resource=source-listings" },
    { "source": "/property/:property", "destination": "/index?property=:property" }
  ]
}
