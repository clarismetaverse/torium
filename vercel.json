{
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/listing-asset.js": { "maxDuration": 30, "regions": ["fra1"] },
    "api/renewals.js": { "maxDuration": 30, "regions": ["fra1"] },
    "api/run-triage.js": { "maxDuration": 300 },
    "api/run-valuation.js": { "maxDuration": 300 },
    "api/run-villas.js": { "maxDuration": 300 }
  },
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/register",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/set-password",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth-session", "destination": "/api/account?resource=session" },
    { "source": "/api/auth-password", "destination": "/api/account?resource=password" },
    { "source": "/api/investor-preferences", "destination": "/api/account?resource=preferences" },
    { "source": "/api/triage-runs", "destination": "/api/triage?resource=runs" },
    { "source": "/api/triage-properties", "destination": "/api/triage?resource=properties" },
    { "source": "/api/triage-source-listings", "destination": "/api/triage?resource=source-listings" },
    { "source": "/property/:property", "destination": "/index?property=:property" }
  ]
}
