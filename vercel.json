{
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/listing-asset.js": { "maxDuration": 30, "regions": ["fra1"] },
    "api/run-triage.js": { "maxDuration": 300 },
    "api/run-valuation.js": { "maxDuration": 300 },
    "api/run-villas.js": { "maxDuration": 300 }
  },
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false }
  ],
  "rewrites": [
    { "source": "/property/:property", "destination": "/index?property=:property" }
  ]
}
